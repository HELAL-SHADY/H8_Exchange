// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  password     String
  role         Role     @default(USER)

  // User profile
  binanceUid   String?
  walletNumber String?
  profileImage String?
  telegramUsername String?

  // Security & 2FA
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  // Relationships
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  userWallets     UserWallet[]
  supportTickets  SupportTicket[]
  ticketMessages  SupportMessage[]
  handledTickets  SupportTicket[]  @relation("AssignedAgent")

  // Metadata
  isVerified Boolean  @default(false)
  isBanned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // e.g. "My Binance Pay", "InstaPay Principal", "USDT TRC20"
  type      String   // VODAFONE_CASH, INSTAPAY, BINANCE_PAY, BYBIT_PAY, CRYPTO_WALLET
  network   String?  // TRC20, BEP20, ERC20, etc.
  address   String   // Phone number, UID, or on-chain address
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_wallets")
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String?  @unique // Human readable unique reference: e.g. H8-BUY-98421
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Order details
  type   OrderType   @default(BUY)
  amount Float       // Primary requested amount
  status OrderStatus @default(PENDING_REVIEW)

  // Financial snapshot
  rateSnapshot  Float?   // Captured exchange rate at order creation
  usdtAmount    Float?   // Exact USDT calculated
  egpAmount     Float?   // Exact EGP calculated
  fee           Float?   @default(0.0) // Service fee if applicable
  totalAmount   Float?   // Total payable/receivable

  // Payment method used for this order
  paymentMethod String?

  // Receive method
  receiveMethod String?

  // Crypto network for direct deposits / withdrawals (e.g. TRC20, BEP20, ERC20)
  network       String?

  // Blockchain Transaction Hash (For SELL orders or completed payouts)
  txHash        String?

  // User information snapshot
  fullName     String
  phone        String
  binanceUid   String
  walletNumber String

  // Proof and verification
  proofImageUrl String?
  proofImageId  String?

  // Admin notes and execution
  adminNote       String?
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?

  // Relationships
  reviews         Review[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  statusHistory   OrderStatusHistory[]
  supportTickets  SupportTicket[]

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  changedBy  String?     // User ID or 'SYSTEM'
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model SupportTicket {
  id          String         @id @default(cuid())
  ticketNumber String        @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject     String
  category    TicketCategory @default(GENERAL)
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedToId String?
  assignedTo  User?          @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages    SupportMessage[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

model Review {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Review content
  rating  Int     @default(5)
  comment String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orderId])
  @@index([orderId])
  @@map("reviews")
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Notification details
  type      NotificationType
  title     String
  message   String
  actionUrl String?

  // Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Metadata
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Action details
  actionType        ActionType
  actionDescription String

  // Metadata
  ipAddress  String?
  deviceInfo String?
  userAgent  String?

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

model ExchangeRate {
  id String @id @default(cuid())

  // Current rates
  buyRate  Float @default(51.0)
  sellRate Float @default(50.0)

  // Limits
  minOrderAmount Float @default(100.0)
  maxOrderAmount Float @default(10000.0)

  // Trading status
  tradingEnabled Boolean @default(true)
  buyFeePercent  Float   @default(0.0)
  sellFeePercent Float   @default(0.0)

  // Settings
  isAutomatic  Boolean @default(false)
  profitMargin Float?  @default(2.0)

  // Admin
  updatedBy String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

model RateHistory {
  id String @id @default(cuid())

  // Previous rates
  oldBuyRate  Float
  oldSellRate Float

  // New rates
  newBuyRate  Float
  newSellRate Float

  // Admin
  updatedBy String

  // Metadata
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("rate_history")
}

model PaymentMethodConfig {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. VODAFONE_CASH, INSTAPAY, BINANCE_PAY, BYBIT_PAY, USDT_TRC20
  nameEn      String
  nameAr      String
  description String?
  accountDetails String? // Wallet address, IBAN, InstaPay Address or Mobile Number
  isActive    Boolean  @default(true)
  type        String   // FIAT, CRYPTO
  minAmount   Float?
  maxAmount   Float?
  instructions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_method_configs")
}

model SiteSettings {
  id String @id @default(cuid())

  // Payment Information
  binanceUid         String @default("")
  vodafoneCashNumber String @default("")

  // New payment methods
  instapayNumber String @default("")
  bybitPayId     String @default("")

  // Crypto Deposit Addresses
  usdtTrc20Address String? @default("")
  usdtBep20Address String? @default("")

  // Contact
  telegramUsername String? @default("")
  telegramSupportUrl String? @default("https://t.me/H8ExchangeSupport")
  supportEmail     String? @default("")

  // Website
  announcement String? @default("")

  // Enable / Disable Orders
  buyEnabled  Boolean @default(true)
  sellEnabled Boolean @default(true)

  // Enable / Disable Payment Methods
  instapayEnabled Boolean @default(true)
  vodafoneEnabled Boolean @default(true)
  binanceEnabled  Boolean @default(true)
  bybitEnabled    Boolean @default(true)
  cryptoEnabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// Enums
enum Role {
  USER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum OrderType {
  BUY
  SELL
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TicketCategory {
  GENERAL
  BUY_ORDER
  SELL_ORDER
  PAYMENT_VERIFICATION
  ACCOUNT
  TECHNICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  ORDER_SUBMITTED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_COMPLETED
  REVIEW_SUBMITTED
  SYSTEM_UPDATE
  TICKET_REPLY
  SECURITY_ALERT
}

enum ActionType {
  USER_REGISTRATION
  USER_LOGIN
  CREATE_BUY_ORDER
  CREATE_SELL_ORDER
  UPLOAD_PROOF
  SUBMIT_REVIEW
  ADMIN_LOGIN
  APPROVE_ORDER
  REJECT_ORDER
  MARK_COMPLETED
  EDIT_EXCHANGE_RATES
  UPDATE_SETTINGS
  DELETE_REVIEW
  EDIT_ORDER
  EXPORT_ORDERS
  PASSWORD_RESET
  CREATE_SUPPORT_TICKET
  REPLY_SUPPORT_TICKET
  RESOLVE_SUPPORT_TICKET
}
